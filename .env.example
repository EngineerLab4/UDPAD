# ==============================================================================
# UDPAD Citizen Public Documentation Portal - Environment Configuration
# ==============================================================================

# Backend Server Port
PORT=5001
NODE_ENV=development

# JWT Secret
JWT_SECRET=udpad-secure-citizen-jwt-secret-key-2026

# ==============================================================================
# Supabase PostgreSQL Database Configuration
# (When you are ready to connect Supabase, fill in these values)
# 1. Go to https://supabase.com and create a project
# 2. In Supabase 'SQL Editor', run the provided 'supabase-schema.sql' file
# 3. In Supabase 'Settings' > 'API', copy your Project URL & Anon Key below:
# ==============================================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Alternatively, direct PostgreSQL connection string (if using self-hosted Postgres):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/udpad
DATABASE_URL=
